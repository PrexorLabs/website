{
  "name": "@prexorlabs/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "prepare": "svelte-kit sync && pnpm messages || echo ''",
    "check": "pnpm messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "fonts": "node scripts/subset-fonts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@inlang/paraglide-js": "^2.29.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "subset-font": "^2.9.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
