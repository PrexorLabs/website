{
  "ci": {
    "collect": {
      "staticDistDir": "apps/web/.svelte-kit/cloudflare",
      "url": ["http://localhost/", "http://localhost/de/", "http://localhost/legal/privacy/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost/(de/)?$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "resource-summary:image:size": [
              "error",
              {
                "maxNumericValue": 102400
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 204800
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/legal/",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 102400
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
